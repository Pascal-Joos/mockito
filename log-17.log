    if (!returnsNull() && !invocationInfo.isValidReturnType(returnType())) {
      throw wrongTypeOfReturnValue(
          invocationInfo.printMethodReturnType(),
          printReturnType(),
          invocationInfo.getMethodName());
    }
}
